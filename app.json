{
  "expo": {
    "name": "KenntyFit",
    "slug": "kennty-fitness-tracker",
    "scheme": "kenntyfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./profilephoto/kennty_logo_icon_dark.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kennty.fitness"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./profilephoto/kennty_logo_icon_dark.png",
        "backgroundColor": "#0a0e1a"
      },
      "package": "com.kennty.fitness",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./profilephoto/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./profilephoto/kennty_logo_icon_dark.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0e1a"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow KenntyFit to access motion sensors."
        }
      ]
    ],
    "extra": {
      "router": {},
      "apiBaseUrl": "http://172.16.16.178:8081",
      "eas": {
        "projectId": "dab5ee1b-6eb7-43b7-83dd-21f81406be2c"
      }
    }
  }
}
